<!-- 登录门 -->
<view wx:if="{{!session}}" class="card" style="margin-top:80rpx;text-align:center;">
  <view style="font-size:36rpx;font-weight:700;color:#8c1f28;">长赢组合助手</view>
  <view class="muted" style="margin:16rpx 0 32rpx;">基于E大（ETF拯救世界）长赢指数体系\n估值驱动 · 分档买入 · 动态再平衡</view>
  <button class="btn-primary" loading="{{loggingIn}}" bindtap="onLogin">微信一键登录</button>
  <view wx:if="{{loginError}}" style="color:#c0392b;font-size:24rpx;margin-top:16rpx;">{{loginError}}</view>
  <view class="muted" style="margin-top:24rpx;">登录后可记录持仓、估值分位并接收操作提醒</view>
</view>

<block wx:else>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:if="{{loadError}}" class="empty">{{loadError}}</view>

  <block wx:if="{{!loading && settings}}">
    <!-- 顶部标题栏：右侧消息中心入口 -->
    <view class="row between" style="padding:24rpx 28rpx 4rpx;">
      <view style="font-size:34rpx;font-weight:700;color:#8c1f28;">
        长赢组合助手
        <text wx:if="{{accountName}}" style="font-size:24rpx;color:#9a6a6a;font-weight:400;margin-left:12rpx;">{{accountName}}<text wx:if="{{accountCount > 1}}">（共{{accountCount}}个账户）</text></text>
      </view>
      <view bindtap="goMessages" style="position:relative;padding:8rpx 20rpx;background:#fff;border-radius:28rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.06);font-size:26rpx;color:#8c1f28;">
        消息中心
        <view wx:if="{{unread > 0}}" style="position:absolute;top:-10rpx;right:-10rpx;min-width:32rpx;height:32rpx;line-height:32rpx;text-align:center;background:#c0392b;color:#fff;border-radius:16rpx;font-size:20rpx;padding:0 6rpx;">{{unread > 99 ? '99+' : unread}}</view>
      </view>
    </view>

    <!-- 资金与温度计 -->
    <view class="card">
      <view class="card-title">
        <text>资金与市场温度</text>
        <text class="muted">{{summary.tempLabel}}</text>
      </view>
      <view class="input-line">
        <text class="label">投资总资金</text>
        <text style="flex:1;font-size:30rpx;font-weight:600;">{{summary.total/10000}}万</text>
        <text class="muted" style="font-size:22rpx;">「我的」页设置</text>
      </view>
      <view class="input-line">
        <text class="label">全市场温度</text>
        <text style="flex:1;font-weight:600;color:#8c1f28;">{{summary.tempLabel}}</text>
        <text class="muted" style="font-size:22rpx;">中证全指分位 {{summary.tempPctText}} · 自动</text>
      </view>
      <view class="muted" style="margin-top:8rpx;">{{summary.tempDesc}}</view>
    </view>

    <!-- 权益与现金占比四档选择 -->
    <view class="card">
      <view class="card-title">
        <text>权益与现金占比</text>
        <text class="muted">{{equityRatio ? '手动设定' : '跟随市场温度 · 自动'}}</text>
      </view>
      <view class="row" style="gap:14rpx;">
        <view wx:for="{{equityOptions}}" wx:key="r" data-r="{{item.r}}" bindtap="onEquityChange"
          style="flex:1;text-align:center;padding:16rpx 0;border-radius:12rpx;border:2rpx solid {{equityOn === item.r ? '#c0392b' : '#eee'}};background:{{equityOn === item.r ? '#fdf0ee' : '#fafafa'}};">
          <view style="font-size:26rpx;font-weight:{{equityOn === item.r ? '700' : '400'}};color:{{equityOn === item.r ? '#c0392b' : '#333'}};">{{item.equityText}}</view>
          <view class="muted" style="font-size:20rpx;">{{item.cashText}}</view>
        </view>
      </view>
      <view class="row between" style="margin-top:12rpx;">
        <text class="muted" style="font-size:22rpx;flex:1;">目标仓位 = 投资总资金 × 权益占比 × 标的在权益中的目标占比</text>
        <text wx:if="{{equityRatio}}" style="font-size:22rpx;color:#c0392b;padding-left:16rpx;" bindtap="onEquityAuto">恢复自动</text>
      </view>
    </view>

    <!-- 仓位汇总 -->
    <view class="card">
      <view class="row between" style="margin-bottom:12rpx;">
        <view>
          <view class="muted">权益总仓 / 上限</view>
          <view style="font-size:34rpx;font-weight:700;">
            {{summary.equityNow/10000}}万
            <text class="muted" style="font-weight:400;"> / {{summary.equityCap/10000}}万</text>
          </view>
        </view>
        <view style="text-align:right;">
          <view class="muted">权益占比（上限{{summary.capPct}}%）</view>
          <view style="font-size:34rpx;font-weight:700;" class="{{summary.ratio > summary.capPct ? 'up' : ''}}">{{summary.ratio}}%</view>
        </view>
      </view>
      <view class="row between muted">
        <text>现金/短债备用金：{{summary.cash/10000}}万</text>
        <text>总资金：{{summary.total/10000}}万</text>
      </view>
    </view>

    <!-- 操作提醒（高亮突出） -->
    <view class="card" style="background:linear-gradient(135deg,#fdf0ee 0%,#fde4e0 100%);border:1rpx solid #f2c9c2;">
      <view class="card-title" style="color:#8c1f28;">
        <text>当前操作提醒</text>
        <text class="muted">{{reminders.length}}条</text>
      </view>
      <view wx:if="{{reminders.length === 0}}" class="empty" style="padding:30rpx 0;">
        暂无触发项，估值与行情数据每天自动更新。
      </view>
      <view wx:for="{{reminders}}" wx:key="index" class="row" style="padding:14rpx 0;border-bottom:1rpx solid #f6d9d4;align-items:flex-start;">
        <text style="width:14rpx;height:14rpx;border-radius:50%;margin:10rpx 14rpx 0 2rpx;flex-shrink:0;background:{{item.level === 1 ? '#c0392b' : '#b26a00'}};"></text>
        <view style="flex:1;">
          <view style="font-weight:600;color:#5c1a12;">{{item.title}}</view>
          <view style="color:#8a5a52;font-size:24rpx;margin-top:4rpx;line-height:1.5;">{{item.detail}}</view>
        </view>
      </view>
      <view class="muted" style="margin-top:14rpx;">行情快照 {{marketTime || '—'}} · 更多提醒见右上角「消息中心」</view>
    </view>

    <!-- 持仓明细 -->
    <view class="card">
      <view class="card-title"><text>持仓 vs 目标</text><text class="muted">±5%触发再平衡</text></view>
      <view class="row muted" style="padding-bottom:8rpx;border-bottom:1rpx solid #f0f0f0;font-size:22rpx;">
        <text style="flex:1.6;">标的</text>
        <text style="flex:1.5;text-align:right;">持仓 / 目标金额</text>
        <text style="flex:1.4;text-align:right;">目标比例 / 实际</text>
        <text style="flex:1.6;text-align:right;">偏离</text>
      </view>
      <view wx:for="{{rows}}" wx:key="symbol" class="row" style="padding:14rpx 0;border-bottom:1rpx solid #f8f8f8;">
        <view style="flex:1.6;">
          <view style="font-size:26rpx;">{{item.name}}</view>
          <view>
            <text class="tag" style="background:{{item.tierBg}};color:{{item.tierColor}};margin-right:0;">{{item.tierLabel}}</text>
          </view>
          <view wx:if="{{item.dyText}}" class="muted" style="font-size:20rpx;margin-top:4rpx;">{{item.dyText}}</view>
        </view>
        <view style="flex:1.5;text-align:right;">
          <view style="font-size:26rpx;">{{item.currentText}}</view>
          <view class="muted" style="font-size:20rpx;">目标 {{item.capText}}</view>
        </view>
        <view style="flex:1.4;text-align:right;">
          <view style="font-size:26rpx;">{{item.targetRatioText}}</view>
          <view class="muted" style="font-size:20rpx;">实际 {{item.actualText}}</view>
          <view style="font-size:20rpx;" class="{{item.capWarn ? 'up' : 'muted'}}">上限 {{item.capLimitText}}</view>
        </view>
        <view style="flex:1.6;text-align:right;">
          <view style="font-size:26rpx;" class="{{item.devWarn ? 'up' : ''}}">{{item.devText}}</view>
          <view style="font-size:20rpx;" class="{{item.devAmtWarn ? 'up' : 'muted'}}">{{item.devAmtText}}</view>
        </view>
      </view>
      <view class="muted" style="margin-top:12rpx;">目标金额 = 投资总资金 × 权益占比 × 标的在权益中的目标占比；目标比例 = 标的在权益中的目标占比 × 权益占比；实际比例 = 持仓金额 ÷ 投资总资金；偏离 = 实际比例 − 目标比例，超出 ±5% 标红触发再平衡；上限比例 = 标的在权益中的上限占比 × 权益占比，实际比例超过上限即标红并生成消息预警。</view>
    </view>

    <view class="risk-tip">风险提示：本工具仅为基于E大投资理念的策略推演记录工具，不构成投资建议。指数基金有波动亏损风险，请独立审慎决策。</view>
  </block>
</block>
