<view wx:if="{{!session}}" class="empty">请先在「总览」页登录</view>

<block wx:else>
  <!-- 头部状态 -->
  <view style="padding:28rpx 28rpx 8rpx;">
    <view style="font-size:36rpx;font-weight:700;color:#8c1f28;">关注标的</view>
    <view class="muted" style="margin-top:6rpx;">
      {{items.length}} 只标的 · 行情 {{marketTime || '—'}}
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <!-- 空态：导入快照 -->
  <view wx:elif="{{items.length === 0}}" class="card" style="text-align:center;padding:60rpx 28rpx;">
    <view style="font-weight:600;margin-bottom:12rpx;">关注列表为空</view>
    <view class="muted" style="margin-bottom:24rpx;">一键导入复盘快照的17只标的（含支撑/压力位与操作提示）</view>
    <button class="btn-primary" loading="{{importing}}" bindtap="onImport">导入复盘快照</button>
  </view>

  <!-- 触发提示条 -->
  <view wx:if="{{!loading && triggered > 0}}" class="card" style="padding:18rpx 28rpx;background:#fdeceb;border:1rpx solid #f2c9c2;">
    <text style="color:#c0392b;font-weight:600;">{{triggered}} 只标的触及低吸/减仓区，详见「消息」页提醒</text>
  </view>

  <!-- 标的清单 -->
  <view wx:for="{{items}}" wx:key="id" class="card" style="padding:22rpx 28rpx;">
    <view class="row between">
      <view>
        <text style="font-size:32rpx;font-weight:700;">{{item.name}}</text>
        <text class="muted" style="margin-left:12rpx;">{{item.code}}</text>
      </view>
      <view style="text-align:right;">
        <text style="font-size:34rpx;font-weight:700;margin-right:16rpx;">{{item.priceText}}</text>
        <text class="{{item.changeClass}}" style="font-weight:600;">{{item.changeText}}</text>
      </view>
    </view>

    <view class="row between" style="margin-top:14rpx;align-items:center;">
      <view class="row" style="gap:12rpx;flex-wrap:wrap;">
        <text wx:if="{{item.buyText}}" class="zone zone-buy">低吸 {{item.buyText}}</text>
        <text wx:if="{{item.sellText}}" class="zone zone-sell">减仓 {{item.sellText}}</text>
      </view>
      <text class="stag {{item.statusCls}}">{{item.statusText}}</text>
    </view>

    <view style="margin-top:14rpx;padding:14rpx 18rpx;background:#f8f9fb;border-radius:12rpx;font-size:24rpx;color:#555;line-height:1.6;">
      <text style="color:#8c1f28;">操作提示：</text>{{item.tip || '—'}}
      <view class="muted" style="margin-top:4rpx;">长线：{{item.long_term}}</view>
    </view>
  </view>

  <!-- E大「关键点位」 -->
  <view wx:if="{{keyPoints.length > 0}}" class="kp-wrap">
    <view class="kp-head">
      <view class="kp-head-title">E大「关键点位」</view>
      <view class="kp-head-sub">笔记 {{kpDate}} · 绿色=大支撑 · 橙色=正常区 · 粉色=外太空</view>
    </view>

    <view class="kp-body">
    <view wx:for="{{keyPoints}}" wx:key="symbol" class="kp-card">
      <view class="kp-row-top">
        <view class="kp-name-wrap">
          <text class="kp-name">{{item.name}}</text>
          <text class="kp-code">{{item.code}}</text>
        </view>
        <view class="kp-price-wrap">
          <view class="kp-price">{{item.priceText}}</view>
          <view class="kp-asof">{{item.asOfText}}</view>
        </view>
      </view>

      <view class="kp-dist-row">
        <text class="kp-dist">距离大支撑：<text class="{{item.toSupCls}}">{{item.toSupText}}</text></text>
        <text wx:if="{{item.toSkyText}}" class="kp-dist">距离外太空：<text class="{{item.toSkyCls}}">{{item.toSkyText}}</text></text>
        <text wx:if="{{item.supDriftText}}" class="kp-drift">{{item.supDriftText}}</text>
      </view>

      <view class="kp-bar">
        <view wx:for="{{item.segments}}" wx:for-item="seg" wx:key="id" class="kp-seg {{seg.cls}}" style="width:{{seg.width}}%;"></view>
        <view wx:for="{{item.marks}}" wx:for-item="mk" wx:key="id" class="kp-mark {{mk.cls}}" style="left:{{mk.left}}%;"></view>
        <view wx:if="{{item.band}}" class="kp-band" style="left:{{item.band.left}}%;width:{{item.band.width}}%;"></view>
        <view class="kp-now" style="left:{{item.priceLeft}}%;"></view>
      </view>

      <view class="kp-label-layer">
        <view class="kp-label {{item.supAlign}}" style="left:{{item.supLeft}}%;">
          <text class="kp-label-num">{{item.supText}}</text>
          <text class="kp-label-txt">{{item.supLabel}}</text>
        </view>
        <view wx:if="{{item.skyText}}" class="kp-label {{item.skyAlign}}" style="left:{{item.skyLeft}}%;">
          <text class="kp-label-num kp-red">{{item.skyText}}</text>
          <text class="kp-label-txt kp-red">{{item.skyLabel}}</text>
        </view>
      </view>

      <view class="kp-note">{{item.note}}</view>
      <view wx:if="{{item.supDriftTip}}" class="kp-drift-tip">{{item.supDriftTip}}</view>
    </view>
    </view>

    <view class="kp-foot">点位来自 E大笔记原文。收盘点位每个交易日 19:00 随估值任务更新：沪深300、中证500、A500、红利100低波、中证医疗取 ETF.run（与估值提醒页同源），创业板R 取腾讯行情，黄金TD 取新浪「黄金延期 Au(T+D)」。色带按“大支撑→外太空”区间等比映射，仅供参考，不构成投资建议。</view>
  </view>

  <view class="risk-tip">行情由云端定时任务自动更新，支撑/压力位与操作提示来自最新复盘锚点。触及提醒同步推送到「消息」页。仅供参考，不构成投资建议。</view>
</block>
